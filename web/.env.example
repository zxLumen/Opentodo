# Opentodo Web 环境变量(复制成 .env,已 gitignore)
# 本地 [[ web/.env ]] 与博客 [[ apps/next-home/.env.local ]] 用**同一个** SESSION_SECRET,
# 就能实现「博客登录 → 本应用为站长」的 SSO。

# 与博客共享的会话密钥(必配,否则不认 SSO);生产环境务必用足够随机的值。
SESSION_SECRET=

# 站长数据文件。指向桌面 App 那份即可与桌面同源:
# OPENTODO_FILE=/Users/you/.config/opentodo/todos.json
OPENTODO_FILE=./data/todos.json

# 运行期数据目录(访客数据 visitors/、对话记录 chat/、settings.json、owner.token 都放这里)。
# 默认 ./data。**容器里务必指到挂载卷**(如 /data),否则落在容器可写层,重建即丢。
# OPENTODO_DATA_DIR=/data

# 直接访问用的站长口令(兜底;不设则自动生成到 data/owner.token,启动时打印)。
# OPENTODO_OWNER_TOKEN=

# 是否放行访客使用 AI(走站长配的 provider/model);默认放行,=0 关闭。
# OPENTODO_VISITOR_AI=0

# 端口(默认 8787)
# PORT=8787
